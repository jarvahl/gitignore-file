{
  inputs,
  module,
  pkgs,
}:
let
  inherit (pkgs) lib;
  systems = [
    "x86_64-linux"
    "aarch64-linux"
    "x86_64-darwin"
    "aarch64-darwin"
  ];
  evaluate =
    modules:
    inputs.flake-parts.lib.mkFlake { inherit inputs; } {
      imports = [ module ] ++ modules;
      inherit systems;
    };
  empty = evaluate [ ];
  disabled = evaluate [ { gitignore.enable = false; } ];
  composed = evaluate [
    {
      gitignore.patterns = [
        ".direnv/"
        "result"
      ];
    }
    {
      gitignore.patterns = [
        ".env"
        "*.key"
      ];
    }
  ];
  orderedModules = [
    { gitignore.patterns = lib.mkAfter [ "!important.log" ]; }
    {
      gitignore.patterns = [
        "*.log"
        "*.log"
      ];
    }
    { gitignore.patterns = lib.mkBefore [ "z-last-alphabetically" ]; }
  ];
  ordered = evaluate orderedModules;
  repeated = evaluate orderedModules;
  filesModule = {
    perSystem = { config, ... }: {
      config.packages.registered-files = pkgs.writeText "registered-files.json" (
        builtins.toJSON config.files.file
      );
      options.files.file = lib.mkOption {
        default = { };
        type = lib.types.attrsOf lib.types.unspecified;
      };
    };
  };
  integrated = evaluate (orderedModules ++ [ filesModule ]);
  integratedDisabled = evaluate [
    filesModule
    { gitignore.enable = false; }
  ];
  forced = evaluate (orderedModules ++ [ { gitignore.patterns = lib.mkForce [ "forced" ]; } ]);
  invalid = evaluate [ { gitignore.patterns = [ "one\ntwo" ]; } ];
  system = pkgs.stdenv.hostPlatform.system;
  packages = flake: flake.packages.${system};
  program = flake: flake.apps.${system}.gitignore.program;
  header = "# Generated by github:jarvahl/gitignore-file. DO NOT EDIT.";
in
assert builtins.all (
  system:
  empty.apps.${system}.gitignore.type == "app"
  && lib.hasSuffix "/bin/gitignore" empty.apps.${system}.gitignore.program
  && !(disabled.apps.${system} ? gitignore)
  && !(disabled.packages.${system} ? gitignore-file)
) systems;
assert (packages ordered).gitignore-file == (packages repeated).gitignore-file;
assert
  !(builtins.tryEval (builtins.deepSeq invalid.packages.${system}.gitignore-file true)).success;
pkgs.runCommand "gitignore-tests"
  {
    nativeBuildInputs = [
      pkgs.coreutils
      pkgs.gitMinimal
    ];
  }
  ''
    export HOME="$TMPDIR/home"
    mkdir -p "$HOME"
    printf '%s\n' '${header}' "" > expected
    cmp expected ${(packages empty).gitignore-file}
    printf '%s\n' .env '*.key' .direnv/ result >> expected
    cmp expected ${(packages composed).gitignore-file}
    printf '%s\n' '${header}' "" z-last-alphabetically '*.log' '*.log' '!important.log' > expected
    cmp expected ${(packages ordered).gitignore-file}
    cmp ${(packages ordered).gitignore-file} ${(packages repeated).gitignore-file}
    printf '%s\n' '${header}' "" forced > forced
    cmp forced ${(packages forced).gitignore-file}
    printf '%s' ${
      lib.escapeShellArg (
        builtins.toJSON {
          ".gitignore".source = (packages ordered).gitignore-file;
        }
      )
    } > registered-files.json
    cmp registered-files.json ${(packages integrated).registered-files}
    printf '{}' > registered-files.json
    cmp registered-files.json ${(packages integratedDisabled).registered-files}

    mkdir 'repository with spaces'
    cd 'repository with spaces'
    git init -q
    mkdir -p 'nested directory/deeper'
    cd 'nested directory/deeper'
    ${program ordered}
    test ! -e .gitignore
    cd ../..
    cmp .gitignore ${(packages ordered).gitignore-file}
    cp .gitignore expected
    # An unchanged file must retain its inode as well as its content.
    ln .gitignore unchanged
    ${program ordered}
    test .gitignore -ef unchanged
    cmp .gitignore expected
    touch debug.log important.log
    git check-ignore -q debug.log
    if git check-ignore -q important.log; then exit 1; fi

    ${program composed}
    cmp .gitignore ${(packages composed).gitignore-file}

    printf '%s\n' 'hand-written' > .gitignore
    if ${program empty}; then exit 1; fi
    test "$(< .gitignore)" = hand-written
    : > .gitignore
    if ${program empty}; then exit 1; fi
    test ! -s .gitignore
    rm .gitignore
    printf '%s\n' 'do not touch' > target
    ln -s target .gitignore
    if ${program empty}; then exit 1; fi
    test "$(< target)" = 'do not touch'
    rm .gitignore
    ln -s missing .gitignore
    if ${program empty}; then exit 1; fi
    test -L .gitignore
    rm .gitignore
    mkdir .gitignore
    if ${program empty}; then exit 1; fi
    rmdir .gitignore

    ${program empty}
    cmp .gitignore ${(packages empty).gitignore-file}
    if ${program empty} unexpected-argument; then exit 1; fi
    cd "$TMPDIR"
    if ${program empty}; then exit 1; fi
    test ! -e .gitignore
    touch "$out"
  ''
